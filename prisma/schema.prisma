

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?   
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  avatar        String?
  isActive      Boolean   @default(false) @map("is_active")
  lastLogin     DateTime? @map("last_login")
  emailVerified DateTime? @map("email_verified")
  
  // Relations
  roleId    String? @map("role_id")
  companyId String? @map("company_id")
  
  role    Role?    @relation(fields: [roleId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])
  
  // NextAuth relations
  accounts Account[]
  sessions Session[]
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  name        String
  description String?
  permissions String? // JSON string of permissions
  isActive    Boolean @default(true) @map("is_active")
  
  // Relations
  users User[]
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Company {
  id                   String  @id @default(cuid())
  name                 String
  businessTypeId       String? @map("business_type_id")
  registrationNumber   String? @map("registration_number")
  tinNumber            String? @map("tin_number")
  email                String?
  phone                String?
  website              String?
  address              String?
  regionId             String? @map("region_id")
  digitalAddress       String? @map("digital_address")
  currency             String  @default("GHS")
  timezone             String  @default("GMT")
  logo                 String?
  primaryColor         String? @map("primary_color")
  isActive             Boolean @default(false) @map("is_active")
  subscriptionTierId   String? @map("subscription_tier_id")
  
  // Relations
  businessType     BusinessType?     @relation(fields: [businessTypeId], references: [id])
  region           Region?           @relation(fields: [regionId], references: [id])
  subscriptionTier SubscriptionTier? @relation(fields: [subscriptionTierId], references: [id])
  
  users       User[]
  products    Product[]
  suppliers   Supplier[]
  customers   Customer[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  inventoryLogs  InventoryLog[]
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

model BusinessType {
  id          String  @id @default(cuid())
  name        String
  description String?
  
  // Relations
  companies Company[]

  @@map("business_types")
}

model Region {
  id   String @id @default(cuid())
  name String
  
  // Relations
  companies Company[]
  suppliers Supplier[]
  customers Customer[]

  @@map("regions")
}

model SubscriptionTier {
  id   String @id @default(cuid())
  name String
  
  // Relations
  companies Company[]

  @@map("subscription_tiers")
}

model Unit {
  id   String @id @default(cuid())
  name String @unique
  
  // Products can reference units by name
  productsBase     Product[] @relation("BaseUnit")
  productsPurchase Product[] @relation("PurchaseUnit")
  productsSales    Product[] @relation("SalesUnit")

  @@map("units")
}

model Category {
  id   String @id @default(cuid())
  name String
  
  // Relations
  products Product[]

  @@map("categories")
}

model Product {
  id              String  @id @default(cuid())
  name            String
  description     String?
  sku             String?
  barCode         String? @map("bar_code")
  categoryId      String? @map("category_id")
  
  costPrice       Decimal @map("cost_price") @db.Decimal(20, 2)
  sellingPrice    Decimal @map("selling_price") @db.Decimal(20, 2)
  trackInventory  Boolean @default(false) @map("track_inventory")
  currentStock    Decimal @default(0) @map("current_stock") @db.Decimal(10, 3)
  minStockLevel   Decimal @default(0) @map("min_stock_level") @db.Decimal(10, 3)
  maxStockLevel   Decimal @default(0) @map("max_stock_level") @db.Decimal(10, 3)
  reorderPoint    Decimal @default(0) @map("reorder_point") @db.Decimal(10, 3)
  
  baseUnitId      String? @map("base_unit_id")
  purchaseUnitId  String? @map("purchase_unit_id")
  salesUnitId     String? @map("sales_unit_id")
  
  unitsPerPurchase Decimal @default(1) @map("units_per_purchase") @db.Decimal(10, 3)
  unitPerSale      Decimal? @map("unit_per_sale") @db.Decimal(10, 3)
  
  brand       String?
  model       String?
  color       String?
  size        String?
  weight      Decimal? @db.Decimal(8, 3)
  
  images      String?
  thumbnail   String?
  
  isActive    Boolean @default(true) @map("is_active")
  isService   Boolean @default(false) @map("is_service")
  isTaxable   Boolean @default(true) @map("is_taxable")
  taxRate     Decimal @default(0.0000) @map("tax_rate") @db.Decimal(5, 4)
  
  companyId String @map("company_id")
  
  // Relations
  category     Category? @relation(fields: [categoryId], references: [id])
  baseUnit     Unit?     @relation("BaseUnit", fields: [baseUnitId], references: [id])
  purchaseUnit Unit?     @relation("PurchaseUnit", fields: [purchaseUnitId], references: [id])
  salesUnit    Unit?     @relation("SalesUnit", fields: [salesUnitId], references: [id])
  company      Company   @relation(fields: [companyId], references: [id])
  
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  inventoryLogs InventoryLog[]
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model Supplier {
  id           String  @id @default(cuid())
  name         String
  contactPerson String? @map("contact_person")
  email        String?
  phone        String?
  address      String?
  city         String?
  regionId     String? @map("region_id")
  country      String?
  paymentTerms String? @map("payment_terms")
  isActive     Boolean @default(true) @map("is_active")
  
  companyId String @map("company_id")
  
  // Relations
  region  Region?  @relation(fields: [regionId], references: [id])
  company Company  @relation(fields: [companyId], references: [id])
  
  purchaseOrders PurchaseOrder[]
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("suppliers")
}

model Customer {
  id           String      @id @default(cuid())
  name         String?
  email        String?
  phone        String?
  address      String?
  city         String?
  regionId     String?     @map("region_id")
  customerType CustomerType @default(INDIVIDUAL) @map("customer_type")
  isActive     Boolean     @default(true) @map("is_active")
  
  companyId String @map("company_id")
  
  // Relations
  region  Region?  @relation(fields: [regionId], references: [id])
  company Company  @relation(fields: [companyId], references: [id])
  
  salesOrders SalesOrder[]
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("customers")
}

model PurchaseOrder {
  id           String            @id @default(cuid())
  orderNum     String            @unique @map("order_num")
  supplierId   String?           @map("supplier_id")
  orderDate    DateTime          @map("order_date")
  expectedDate DateTime?         @map("expected_date")
  receivedDate DateTime?         @map("received_date")
  status       PurchaseOrderStatus
  subTotal     Decimal           @default(0) @map("sub_total") @db.Decimal(12, 2)
  taxAmount    Decimal           @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount  Decimal           @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes        String?
  
  companyId String @map("company_id")
  
  // Relations
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  company  Company   @relation(fields: [companyId], references: [id])
  
  items PurchaseItem[]
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("purchase_orders")
}

model PurchaseItem {
  id               String  @id @default(cuid())
  productId        String  @map("product_id")
  purchaseOrderId  String  @map("purchase_order_id")
  quantityOrdered  Decimal @map("quantity_ordered") @db.Decimal(10, 3)
  quantityReceived Decimal @default(0) @map("quantity_received") @db.Decimal(10, 3)
  unitCost         Decimal @map("unit_cost") @db.Decimal(10, 2)
  totalCost        Decimal? @map("total_cost") @db.Decimal(12, 2)
  
  // Relations
  product       Product       @relation(fields: [productId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("purchase_items")
}

model SalesOrder {
  id             String           @id @default(cuid())
  orderNum       String           @unique @map("order_num")
  customerId     String?          @map("customer_id")
  orderDate      DateTime         @default(now()) @map("order_date")
  deliveryDate   DateTime?        @map("delivery_date")
  status         SalesOrderStatus
  subTotal       Decimal          @default(0) @map("sub_total") @db.Decimal(12, 2)
  discountAmount Decimal          @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal          @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal          @default(0) @map("total_amount") @db.Decimal(12, 2)
  paymentStatus  PaymentStatus    @map("payment_status")
  notes          String?
  
  companyId String @map("company_id")
  
  // Relations
  customer Customer? @relation(fields: [customerId], references: [id])
  company  Company   @relation(fields: [companyId], references: [id])
  
  items SaleItem[]
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sales_orders")
}

model SaleItem {
  id              String  @id @default(cuid())
  salesOrderId    String  @map("sales_order_id")
  productId       String  @map("product_id")
  quantity        Decimal @db.Decimal(10, 3)
  unitPrice       Decimal @map("unit_price") @db.Decimal(10, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxRate         Decimal @default(0) @map("tax_rate") @db.Decimal(5, 4)
  lineTotal       Decimal @map("line_total") @db.Decimal(12, 2)
  
  // Relations
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sale_items")
}

model InventoryLog {
  id              String             @id @default(cuid())
  productId       String             @map("product_id")
  transactionType TransactionType    @map("transaction_type")
  referenceType   ReferenceType      @map("reference_type")
  referenceId     String?            @map("reference_id")
  
  quantityBefore  Decimal            @map("quantity_before") @db.Decimal(10, 3)
  quantityChange  Decimal            @map("quantity_change") @db.Decimal(10, 3)
  quantityAfter   Decimal            @map("quantity_after") @db.Decimal(10, 3)
  
  unitCost        Decimal?           @map("unit_cost") @db.Decimal(10, 2)
  notes           String?
  transactionDate DateTime           @default(now()) @map("transaction_date")
  createdBy       String?            @map("created_by")
  
  companyId String @map("company_id")
  
  // Relations
  product Product @relation(fields: [productId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@map("inventory_logs")
}

// Enums
enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum PurchaseOrderStatus {
  PENDING
  ORDERED
  RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}ss

enum TransactionType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER
  RETURN
}

enum ReferenceType {
  PURCHASE_ORDER
  SALES_ORDER
  MANUAL_ADJUSTMENT
  STOCK_TRANSFER
}